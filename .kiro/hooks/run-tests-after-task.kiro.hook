{
  "enabled": true,
  "name": "Run Tests After Task",
  "description": "Automatically runs the pytest test suite after each spec task is marked complete, so test results are available without manual approval.",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "cd spacemud && python -m pytest tests/ -v --tb=short",
    "timeout": 120
  }
}